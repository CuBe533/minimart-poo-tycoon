<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
        xmlns="http://javafx.openjfx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.minimart.controller.MainController"
        prefWidth="1024"
        prefHeight="768"
        styleClass="ventana-principal">

    <center>
        <VBox styleClass="zona-central">

            <HBox styleClass="franja-estanterias" VBox.vgrow="ALWAYS" spacing="30" alignment="CENTER">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <!-- Slot estantería 1 -->
                <VBox fx:id="slotEstanteria1" styleClass="slot-estanteria" alignment="CENTER" spacing="6" prefWidth="126" maxWidth="126">
                    <ImageView fx:id="imgEstanteria1" fitWidth="170" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="stockBar1" prefWidth="110" progress="1.0" styleClass="barra-stock"/>
                    <Label fx:id="labelTipo1" text="—" styleClass="label-tipo-producto"/>
                </VBox>

                <!-- Slot estantería 2 -->
                <VBox fx:id="slotEstanteria2" styleClass="slot-estanteria" alignment="CENTER" spacing="6" prefWidth="126" maxWidth="126" opacity="0.3">
                    <ImageView fx:id="imgEstanteria2" fitWidth="170" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="stockBar2" prefWidth="110" progress="0.0" styleClass="barra-stock"/>
                    <Label fx:id="labelTipo2" text="—" styleClass="label-tipo-producto"/>
                </VBox>

                <!-- Slot estantería 3 -->
                <VBox fx:id="slotEstanteria3" styleClass="slot-estanteria" alignment="CENTER" spacing="6" prefWidth="126" maxWidth="126" opacity="0.3">
                    <ImageView fx:id="imgEstanteria3" fitWidth="170" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="stockBar3" prefWidth="110" progress="0.0" styleClass="barra-stock"/>
                    <Label fx:id="labelTipo3" text="—" styleClass="label-tipo-producto"/>
                </VBox>

                <!-- Slot estantería 4 -->
                <VBox fx:id="slotEstanteria4" styleClass="slot-estanteria" alignment="CENTER" spacing="6" prefWidth="126" maxWidth="126" opacity="0.3">
                    <ImageView fx:id="imgEstanteria4" fitWidth="170" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="stockBar4" prefWidth="110" progress="0.0" styleClass="barra-stock"/>
                    <Label fx:id="labelTipo4" text="—" styleClass="label-tipo-producto"/>
                </VBox>

                <!-- Slot estantería 5 -->
                <VBox fx:id="slotEstanteria5" styleClass="slot-estanteria" alignment="CENTER" spacing="6" prefWidth="126" maxWidth="126" opacity="0.3">
                    <ImageView fx:id="imgEstanteria5" fitWidth="170" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="stockBar5" prefWidth="110" progress="0.0" styleClass="barra-stock"/>
                    <Label fx:id="labelTipo5" text="—" styleClass="label-tipo-producto"/>
                </VBox>

            </HBox>

            <HBox styleClass="franja-cajeros" prefHeight="280" spacing="20" alignment="CENTER_LEFT">
                <padding><Insets top="16" right="16" bottom="16" left="24"/></padding>

                <!-- Slot cajero 1 -->
                <VBox fx:id="slotCajero1" styleClass="slot-cajero" alignment="CENTER" spacing="6" prefWidth="101" maxWidth="101">
                    <ImageView fx:id="imgCajero1" fitWidth="110" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="atenderBar1" prefWidth="85" progress="0.0" styleClass="barra-atencion"/>
                </VBox>

                <!-- Slot cajero 2 -->
                <VBox fx:id="slotCajero2" styleClass="slot-cajero" alignment="CENTER" spacing="6" prefWidth="101" maxWidth="101" opacity="0.3">
                    <ImageView fx:id="imgCajero2" fitWidth="90" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="atenderBar2" prefWidth="85" progress="0.0" styleClass="barra-atencion"/>
                </VBox>

                <!-- Slot cajero 3 -->
                <VBox fx:id="slotCajero3" styleClass="slot-cajero" alignment="CENTER" spacing="6" prefWidth="101" maxWidth="101" opacity="0.3">
                    <ImageView fx:id="imgCajero3" fitWidth="90" preserveRatio="true" smooth="false"/>
                    <ProgressBar fx:id="atenderBar3" prefWidth="85" progress="0.0" styleClass="barra-atencion"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="separador-cajeros"/>

                <!-- Compradores -->
                <ImageView fx:id="comprador1" fitWidth="90" opacity="0.4" preserveRatio="true" smooth="false"/>
                <ImageView fx:id="comprador2" fitWidth="90" opacity="0.4" preserveRatio="true" smooth="false"/>
                <ImageView fx:id="comprador3" fitWidth="90" opacity="0.4" preserveRatio="true" smooth="false"/>
                <ImageView fx:id="comprador4" fitWidth="90" opacity="0.4" preserveRatio="true" smooth="false"/>

            </HBox>
        </VBox>
    </center>

    <right>
        <VBox styleClass="panel-derecho" minWidth="270" maxWidth="270" spacing="8">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <Label text="UPGRADES" styleClass="titulo-panel"/>

            <VBox styleClass="tarjeta-upgrade" spacing="4">
                <HBox spacing="6" alignment="CENTER_LEFT" >
                    <ImageView fx:id="imgUpgradeEstanteria" fitWidth="36" fitHeight="36" preserveRatio="true" smooth="false"/>

                    <VBox spacing="2">
                        <Label text="Estantería" styleClass="label-upgrade-nombre"/>
                        <Label text="\$150" styleClass="label-upgrade-costo"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnUpgrade1"
                        text="COMPRAR"
                        maxWidth="Infinity"
                        style="-fx-background-color:#FFD700; -fx-font-weight:bold; -fx-font-size:11px;"/>
            </VBox>

            <VBox styleClass="tarjeta-upgrade" spacing="4">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <ImageView fx:id="imgUpgradeReabastecer" fitWidth="24" fitHeight="24" preserveRatio="true" smooth="false"
                    scaleX="1.8" scaleY="1.8" translateX="8"/>
                    <VBox spacing="2">
                        <Label text="    Reabastecer" styleClass="label-upgrade-nombre"/>
                        <Label text="   \$50" styleClass="label-upgrade-costo"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnUpgrade2"
                        text="REABASTECER"
                        maxWidth="Infinity"
                        style="-fx-background-color:#FFD700; -fx-font-weight:bold; -fx-font-size:11px;"/>
            </VBox>

            <VBox styleClass="tarjeta-upgrade" spacing="4">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <ImageView fx:id="imgUpgradeCajero" fitWidth="36" fitHeight="36" preserveRatio="true" smooth="false"/>
                    <VBox spacing="2">
                        <Label text="Cajero" styleClass="label-upgrade-nombre"/>
                        <Label text="\$200" styleClass="label-upgrade-costo"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnUpgrade3"
                        text="MEJORAR"
                        maxWidth="Infinity"
                        style="-fx-background-color:#FFD700; -fx-font-weight:bold; -fx-font-size:11px;"/>
            </VBox>

            <Separator/>

            <Label text="ESTADÍSTICAS" styleClass="titulo-panel"/>

            <VBox styleClass="seccion-stats" spacing="4">
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="⭐" styleClass="icono-stat"/>
                    <Label text="Reputación:" styleClass="label-stat-nombre"/>
                </HBox>
                <Label fx:id="labelReputacion" text="100" styleClass="label-stat-valor"/>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="💰" styleClass="icono-stat"/>
                    <Label text="Dinero:" styleClass="label-stat-nombre"/>
                </HBox>
                <Label fx:id="labelDinero" text="\$500.00" styleClass="label-stat-valor label-dinero"/>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="📅" styleClass="icono-stat"/>
                    <Label fx:id="labelDia" text="DÍA 1" styleClass="label-stat-nombre"/>
                </HBox>
            </VBox>
            <AnchorPane prefWidth="250" prefHeight="140"  style="-fx-background-color: rgba(0,0,0,0.05);">

                <ImageView fx:id="imgMostradorPanel" fitWidth="210" preserveRatio="true" smooth="false"
                           AnchorPane.leftAnchor="10" AnchorPane.bottomAnchor="10"/>

                <ImageView fx:id="imgClientePanel" fitWidth="100" preserveRatio="true" smooth="false"
                           AnchorPane.leftAnchor="-30" AnchorPane.bottomAnchor="10" opacity="0.0"/>



                <ImageView fx:id="imgCajeroPanelDerecho" fitWidth="125" preserveRatio="true" smooth="false"
                           AnchorPane.rightAnchor="1" AnchorPane.bottomAnchor="10"/>


            </AnchorPane>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnAvanzarDia"
                    text="DIA 1 →"
                    maxWidth="Infinity"
                    style="-fx-background-color:#FFD700; -fx-font-weight:bold; -fx-font-size:13px; -fx-padding: 10 0 10 0;"/>

        </VBox>
    </right>

</BorderPane>