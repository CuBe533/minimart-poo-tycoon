<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<Pane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minimart.controller.LoginController" style="-fx-background-color: #222; -fx-padding: 20;">
    <children>
        <Label layoutX="95.0" layoutY="25.0" text="MiniMart POO Tycoon" textFill="white">
            <font><Font size="20.0" /></font>
        </Label>
        <Label layoutX="60.0" layoutY="95.0" text="Nombre de usuario:" textFill="white">
            <font><Font size="12.0" /></font>
        </Label>
        <TextField fx:id="txtUsuario" layoutX="60.0" layoutY="118.0" prefHeight="25.0" prefWidth="280.0" promptText="Usuario" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-prompt-text-fill: #666; -fx-border-color: #888; -fx-border-radius: 3;" />
        <Label layoutX="60.0" layoutY="158.0" text="Contraseña:" textFill="white">
            <font><Font size="12.0" /></font>
        </Label>
        <PasswordField fx:id="txtPassword" layoutX="60.0" layoutY="181.0" prefHeight="25.0" prefWidth="280.0" promptText="Contraseña" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-prompt-text-fill: #666; -fx-border-color: #888; -fx-border-radius: 3;" />

        <ComboBox fx:id="comboRol" layoutX="60.0" layoutY="228.0" prefHeight="25.0" prefWidth="280.0" promptText="Seleccionar Rol" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-border-color: #888; -fx-border-radius: 3;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="administrador" />
                    <String fx:value="invitado" />
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnRegistro" layoutX="60.0" layoutY="270.0" prefHeight="25.0" prefWidth="280.0" text="Crear cuenta" style="-fx-background-color: #e0e0e0; -fx-font-size: 11px; -fx-border-radius: 3;" />

        <Button fx:id="btnLogin" layoutX="160.0" layoutY="310.0" prefHeight="30.0" prefWidth="80.0" text="Ingresar" style="-fx-background-color: #FFD700; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-radius: 3;" />

        <Label fx:id="labelError" layoutX="60.0" layoutY="355.0" prefWidth="280.0" textFill="#E24B4A" />
    </children>
</Pane>