<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.minimart.controller.ResumenDiaController"
      alignment="CENTER"
      spacing="16"
      prefWidth="380"
      prefHeight="320"
      style="-fx-background-color:#2B2B2B;">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="labelTituloDia"
           text="RESUMEN DEL DÍA 1"
           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#FFD700; -fx-font-family:'Monospaced';"/>

    <Separator/>

    <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color:rgba(0,0,0,0.2); -fx-background-radius:8; -fx-padding:16;">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="🧾" style="-fx-font-size:16px;"/>
            <Label text="Clientes atendidos:" style="-fx-text-fill:#DDDDDD; -fx-font-size:13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelVentas" text="0" style="-fx-text-fill:#FFFFFF; -fx-font-weight:bold; -fx-font-size:14px;"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="💰" style="-fx-font-size:16px;"/>
            <Label text="Dinero ganado hoy:" style="-fx-text-fill:#DDDDDD; -fx-font-size:13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelGanancia" text="\$0.00" style="-fx-text-fill:#1D9E75; -fx-font-weight:bold; -fx-font-size:14px;"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="🏦" style="-fx-font-size:16px;"/>
            <Label text="Dinero total:" style="-fx-text-fill:#DDDDDD; -fx-font-size:13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelDineroTotal" text="\$500.00" style="-fx-text-fill:#FFD700; -fx-font-weight:bold; -fx-font-size:14px;"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="btnSiguienteDia"
            text="SIGUIENTE DÍA →"
            maxWidth="Infinity"
            style="-fx-background-color:#FFD700; -fx-font-weight:bold; -fx-font-size:13px; -fx-padding:10 0 10 0;"/>
</VBox>
